---
/**
 * TableOfContents.astro
 *
 * 文章侧边栏目录组件。
 * 从 #article 中提取 h2 至 h6 标题构建目录树，支持滚动高亮。
 * 用 position: fixed 固定在右侧，文章内容保持原居中布局。
 *
 * 使用方式（在文章详情页中）：
 *   import TableOfContents from "@/components/TableOfContents.astro";
 *   <TableOfContents />
 */

import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<aside
  id="table-of-contents"
  class="toc-root bg-background/80 fixed top-24 z-30 hidden max-h-[calc(100vh-6rem)] w-65 flex-col overflow-hidden rounded-xl p-4 backdrop-blur-sm xl:flex"
  aria-label={t.toc.label}
  data-footnotes-label={t.toc.footnotes}
  data-expand-label={t.toc.expand}
  data-collapse-label={t.toc.collapse}
  style="left: calc(50% + 384px + 1.5rem)"
>
  <div
    class="border-border mb-2 flex shrink-0 items-center justify-between border-b pb-2"
  >
    <div class="flex items-center gap-2">
      <span class="text-foreground text-sm font-semibold">{t.toc.label}</span>
      <button
        id="toc-toggle"
        class="text-muted-foreground hover:text-foreground hidden text-xs transition-colors"
        type="button"
        aria-expanded="false"></button>
    </div>
  </div>

  <nav id="toc-body" class="flex-1 overflow-y-auto overscroll-contain">
    <ol class="m-0 list-none p-0" id="toc-list"></ol>
  </nav>
</aside>

<script is:inline data-astro-rerun>
  (function () {
    "use strict";

    const headingSelector = "h2, h3, h4, h5, h6";

    function buildTOC() {
      const article = document.getElementById("article");
      const tocList = document.getElementById("toc-list");
      const tocRoot = document.getElementById("table-of-contents");
      const tocToggle = document.getElementById("toc-toggle");
      if (!article || !tocList || !tocRoot || !tocToggle) return;

      const footnotesLabel = tocRoot.dataset.footnotesLabel;
      const expandLabel = tocRoot.dataset.expandLabel;
      const collapseLabel = tocRoot.dataset.collapseLabel;

      const headings = Array.from(
        article.querySelectorAll(headingSelector)
      ).filter(h => h.id);

      if (headings.length < 2) {
        tocRoot.style.display = "none";
        return;
      }

      tocList.innerHTML = "";
      const hasDeepHeadings = headings.some(
        heading => Number(heading.tagName.slice(1)) >= 4
      );

      tocToggle.classList.toggle("hidden", !hasDeepHeadings);
      tocToggle.setAttribute("aria-expanded", "false");
      tocToggle.textContent = expandLabel;

      for (const heading of headings) {
        const li = document.createElement("li");
        li.className = "m-0 leading-[1.4]";
        const headingLevel = Number(heading.tagName.slice(1));
        if (headingLevel >= 4) {
          li.hidden = true;
          li.dataset.deepHeading = "true";
        }
        if (headingLevel > 2) {
          li.style.paddingLeft = `${headingLevel - 2}rem`;
        }

        const a = document.createElement("a");
        a.className =
          "toc-link block px-2 py-[0.2rem] text-[0.8125rem] text-muted-foreground no-underline rounded overflow-hidden text-ellipsis whitespace-nowrap transition-colors hover:text-foreground hover:bg-muted";
        a.href = "#" + heading.id;
        a.textContent =
          heading.id === "footnote-label"
            ? footnotesLabel
            : heading.textContent.replace(/\s*#$/, "");

        a.addEventListener("click", e => {
          e.preventDefault();
          const id = a.getAttribute("href").slice(1);
          const target = document.getElementById(id);
          if (target) {
            target.scrollIntoView({ behavior: "smooth" });
            history.pushState(null, "", "#" + id);
          }
        });

        li.appendChild(a);
        tocList.appendChild(li);
      }

      tocToggle.onclick = () => {
        const isExpanded = tocToggle.getAttribute("aria-expanded") === "true";
        const nextExpanded = !isExpanded;

        for (const item of tocList.querySelectorAll("li[data-deep-heading]")) {
          item.hidden = !nextExpanded;
        }

        tocToggle.setAttribute("aria-expanded", String(nextExpanded));
        tocToggle.textContent = nextExpanded ? collapseLabel : expandLabel;
      };
    }

    function initScrollSpy() {
      const article = document.getElementById("article");
      const tocList = document.getElementById("toc-list");
      if (!article || !tocList) return;

      const headings = Array.from(
        article.querySelectorAll(headingSelector)
      ).filter(h => h.id);
      if (!headings.length) return;

      const observer = new IntersectionObserver(
        entries => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              const prev = tocList.querySelector(".toc-link.active");
              if (prev) prev.classList.remove("active");

              const link = tocList.querySelector(
                '.toc-link[href="#' + CSS.escape(entry.target.id) + '"]'
              );
              if (link) link.classList.add("active");
            }
          }
        },
        { rootMargin: "-80px 0px -70% 0px" }
      );

      for (const h of headings) observer.observe(h);
    }

    function initTOC() {
      buildTOC();
      initScrollSpy();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initTOC);
    } else {
      initTOC();
    }
  })();
</script>
